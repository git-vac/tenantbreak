{
  "version": 1,
  "name": "LedgerCloud collection authorization",
  "base_url": "http://127.0.0.1:8080",
  "identity_check": {
    "path": "/api/me"
  },
  "identities": [
    {
      "id": "alice",
      "tenant": "acme",
      "role": "member",
      "token_env": "TB_ALICE_TOKEN",
      "verify": {
        "/id": "alice",
        "/tenant": "acme",
        "/role": "member"
      }
    },
    {
      "id": "bob",
      "tenant": "acme",
      "role": "member",
      "token_env": "TB_BOB_TOKEN",
      "verify": {
        "/id": "bob",
        "/tenant": "acme",
        "/role": "member"
      }
    },
    {
      "id": "charlie",
      "tenant": "nova",
      "role": "member",
      "token_env": "TB_CHARLIE_TOKEN",
      "verify": {
        "/id": "charlie",
        "/tenant": "nova",
        "/role": "member"
      }
    },
    {
      "id": "admin-acme",
      "tenant": "acme",
      "role": "admin",
      "token_env": "TB_ADMIN_TOKEN",
      "verify": {
        "/id": "admin-acme",
        "/tenant": "acme",
        "/role": "admin"
      }
    }
  ],
  "resources": [
    {
      "id": "alice-invoice",
      "label": "Alice's private invoice",
      "tenant": "acme",
      "path": "/api/invoices",
      "allow": [
        "alice",
        "admin-acme"
      ],
      "control_identity": "alice",
      "match": {
        "/id": "inv-a104",
        "/tenant": "acme",
        "/marker": "TB-FIXTURE-ALICE-104"
      },
      "collection": {
        "items": "/items",
        "next": "/next",
        "max_pages": 4,
        "max_items": 20,
        "identify": {
          "/id": "inv-a104",
          "/tenant": "acme"
        }
      }
    },
    {
      "id": "bob-invoice",
      "label": "Bob's private invoice",
      "tenant": "acme",
      "path": "/api/invoices",
      "allow": [
        "bob",
        "admin-acme"
      ],
      "control_identity": "bob",
      "match": {
        "/id": "inv-a105",
        "/tenant": "acme",
        "/marker": "TB-FIXTURE-BOB-105"
      },
      "collection": {
        "items": "/items",
        "next": "/next",
        "max_pages": 4,
        "max_items": 20,
        "identify": {
          "/id": "inv-a105",
          "/tenant": "acme"
        }
      }
    },
    {
      "id": "charlie-invoice",
      "label": "Charlie's private invoice",
      "tenant": "nova",
      "path": "/api/invoices",
      "allow": [
        "charlie"
      ],
      "control_identity": "charlie",
      "match": {
        "/id": "inv-n201",
        "/tenant": "nova",
        "/marker": "TB-FIXTURE-CHARLIE-201"
      },
      "collection": {
        "items": "/items",
        "next": "/next",
        "max_pages": 4,
        "max_items": 20,
        "identify": {
          "/id": "inv-n201",
          "/tenant": "nova"
        }
      }
    },
    {
      "id": "alice-summary",
      "label": "Alice's invoice fields",
      "tenant": "acme",
      "path": "/api/invoice-summaries/inv-a104",
      "allow": [
        "alice",
        "admin-acme"
      ],
      "control_identity": "alice",
      "match": {
        "/id": "inv-a104",
        "/tenant": "acme",
        "/marker": "TB-FIXTURE-ALICE-104",
        "/amount": 120
      },
      "leak_match": {
        "/id": "inv-a104",
        "/amount": 120
      }
    }
  ]
}
